# Discord Developer Portal -> Bot -> Token
DISCORD_TOKEN=

# Enable Message Content Intent in the Discord Developer Portal.
# Optional: restrict the bot to one Discord server.
GUILD_ID=

# AI provider (OpenAI-compatible chat completions API)
# The bot can start without these values, but .q will explain that AI is not configured.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Conversation settings
MAX_HISTORY_MESSAGES=16
MAX_MESSAGE_LENGTH=1800
USER_COOLDOWN_SECONDS=4
DATABASE_PATH=./data/legion-ai.sqlite
